# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SOFTWARE DE INVENTARIOS P.M.E.
# ==============================================================================
# Instrucciones:
# - En DESARROLLO LOCAL: copie este archivo a '.env' y configure sus valores locales.
# - En PRODUCCIÓN (RENDER): configure estas variables desde el panel 'Environment' del servicio Web.
# NUNCA suba el archivo '.env' real al repositorio Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Núcleo de Django
# ------------------------------------------------------------------------------
# Módulo de configuración activo:
#   Desarrollo: config.settings.development
#   Producción: config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# Modo depuración (estrictamente False en producción, True en desarrollo local)
DEBUG=True

# Clave secreta criptográfica de Django.
# Genere una clave segura para producción (ej: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=cambiar_por_una_clave_secreta_segura_de_50_caracteres_minimo

# ------------------------------------------------------------------------------
# 2. Conexión a Base de Datos (PostgreSQL / Supabase / Render)
# ------------------------------------------------------------------------------
# El backend soporta DOS métodos de conexión:
#
# OPCIÓN A (Recomendada para Render y Supabase): URL Completa
# DATABASE_URL=postgresql://usuario:contraseña@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# OPCIÓN B: Parámetros individuales (utilizada actualmente por el proyecto)
DB_NAME=postgres
DB_USER=postgres.identificador_de_proyecto
DB_PASSWORD=contrasena_segura_de_base_de_datos
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

# Gestión de Conexiones
CONN_MAX_AGE=60
CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT=10

# ------------------------------------------------------------------------------
# 3. Seguridad de Red, Dominios y CORS / CSRF
# ------------------------------------------------------------------------------
# Hosts permitidos (separados por coma)
# En desarrollo: 127.0.0.1,localhost,0.0.0.0,::1
# En Render: .onrender.com,api.inventario-pme.com,mi-backend.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,.onrender.com

# Orígenes autorizados para CORS (Frontend que consume la API)
# En desarrollo: http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# En producción: https://inventario-pme.com,https://mi-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Orígenes confiables para protección CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Proxy Inverso y Parámetros HTTPS (Render)
# ------------------------------------------------------------------------------
# Redirección obligatoria a HTTPS (habilitar en producción)
SECURE_SSL_REDIRECT=True

# Parámetros HSTS
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Cookies seguras
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# Configuración de Proxy Reverso (Render utiliza cabeceras X-Forwarded-Proto y X-Forwarded-For)
USE_SECURE_PROXY=True
TRUST_X_FORWARDED_FOR=True
